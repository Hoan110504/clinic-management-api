# Server Configuration
NODE_ENV=development
PORT=5000

# ==============================================
# SQL SERVER DATABASE CONFIGURATION
# ==============================================
# Host của SQL Server (localhost hoặc IP/hostname)
DB_HOST=localhost

# Port của SQL Server (mặc định 1433)
DB_PORT=1433

# Tên database
DB_NAME=ClinicManagement

# Nếu sử dụng SQL Server Authentication:
DB_USER=xx
DB_PASSWORD=xxxxxx

# Nếu sử dụng Windows Authentication (Trusted Connection):
# Đặt DB_TRUSTED_CONNECTION=true và cấu hình NTLM
DB_TRUSTED_CONNECTION=false
# DB_DOMAIN=YOUR_DOMAIN
# DB_NTLM_USER=your_windows_username
# DB_NTLM_PASSWORD=your_windows_password

# Cấu hình bảo mật kết nối
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# Nếu sử dụng Named Instance (VD: SQLEXPRESS)
# DB_INSTANCE=SQLEXPRESS

# Multiple Active Result Sets
DB_MARS=true

# ==============================================
# JWT / Security
# ==============================================
JWT_SECRET=xxxxxxxxxxxx
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# Rate Limiting (Development: 1000 requests/15min, Production: 100 requests/15min)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug

# ==============================================
# Password Reset OTP Delivery
# ==============================================
# OTP hashing pepper (optional, defaults to JWT_SECRET)
# PASSWORD_RESET_OTP_PEPPER=replace_with_a_random_secret

# Email OTP (SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_app_password
# SMTP_FROM="Noi Khoa Clinic <your_email@example.com>"

# SMS OTP is handled by Firebase Phone Authentication on the client.
# To enable server-side Firebase token verification set one of:
# FIREBASE_SERVICE_ACCOUNT (JSON string) or FIREBASE_SERVICE_ACCOUNT_PATH (path to JSON file)

# ==============================================
# AI Medical Chatbot Configuration
# ==============================================
# Google Gemini API key for AI chatbot functionality
# Get your API key from: https://makersuite.google.com/app/apikey
# Required for the AI Medical Chatbot feature
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_MODEL=gemma-4-26b-a4b-it
# GEMINI_MODEL=gemma-4-31b-it
GEMINI_MODEL=gemini-flash-lite-latest

# ==============================================
# AI Medical Summary Configuration
# ==============================================
# Rate limit: Maximum summary requests per hour per doctor per patient
# Prevents abuse and controls API costs for individual patient summaries
AI_SUMMARY_RATE_LIMIT_PER_PATIENT=10

# Rate limit: Maximum summary requests per minute per doctor (global)
# Controls overall API usage across all patients
AI_SUMMARY_RATE_LIMIT_GLOBAL=30

# Request timeout in milliseconds (30 seconds)
# Maximum time to wait for summary generation before timing out
AI_SUMMARY_TIMEOUT_MS=30000

# Cache TTL (Time To Live) in milliseconds (1 hour = 3600000ms)
# How long to cache generated summaries before regenerating
AI_SUMMARY_CACHE_TTL_MS=3600000


# OTP
# Email OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=xxxx@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="Noi Khoa Clinic"

TELEGRAM_BOT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxx0